<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
           http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.rspereiratech</groupId>
        <artifactId>openapi-collection-generator-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>openapi-collection-generator-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <name>OpenAPI Collection Generator Maven Plugin</name>
    <description>Maven plugin that generates Postman and Insomnia collections from OpenAPI specifications.</description>
    <url>https://github.com/rspereiratech/openapi-collection-generator-maven-plugin</url>

    <scm>
        <connection>scm:git:git://github.com/rspereiratech/openapi-collection-generator-maven-plugin.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/rspereiratech/openapi-collection-generator-maven-plugin.git</developerConnection>
        <url>https://github.com/rspereiratech/openapi-collection-generator-maven-plugin</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/rspereiratech/openapi-collection-generator-maven-plugin/issues</url>
    </issueManagement>

    <dependencies>
        <!-- Swagger Parser -->
        <dependency>
            <groupId>io.swagger.parser.v3</groupId>
            <artifactId>swagger-parser</artifactId>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Plugin -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven-plugin-annotations.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
